{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-factory.local/schemas/sandbox-transport-v1.json",
  "title": "Guest artifact request (authority is supplied by the native relay)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "operation", "marker", "bodyHex", "targetStatus"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{16,128}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
    },
    "operation": {"const": "artifact.submit"},
    "marker": {"type": "string", "minLength": 2, "maxLength": 80, "pattern": "^[a-z0-9-]{2,80}$"},
    "bodyHex": {"type": "string", "minLength": 2, "maxLength": 131072, "pattern": "^(?:[0-9a-f]{2})+$"},
    "targetStatus": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}
  }
}
