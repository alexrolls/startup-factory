[Unit]
Description=Startup Factory protected Beads boundary controller
Requires=systemd-tmpfiles-setup.service
After=local-fs.target systemd-tmpfiles-setup.service

[Service]
Type=simple
# The process starts as root only to create/chown/chmod the socket inside the
# root:transport 0750 tmpfiles directory, then irreversibly drops itself to the
# closed controller UID and transport GID before listen().
ExecStart=/usr/local/bin/startup-factory-beads-controller serve
Restart=on-failure
RestartSec=2s
CapabilityBoundingSet=CAP_CHOWN CAP_SETGID CAP_SETUID
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/run/startup-factory /var/lib/startup-factory/beads-boundary-controller/v1
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
SystemCallArchitectures=native
UMask=0007

[Install]
WantedBy=multi-user.target
