[Unit]
Description=Startup Factory protected Beads boundary controller
Requires=systemd-tmpfiles-setup.service
After=local-fs.target systemd-tmpfiles-setup.service

[Service]
Type=simple
# The process starts as root only to create/chown/chmod the socket inside the
# root:transport 0750 tmpfiles directory, then irreversibly drops itself to the
# closed controller UID and transport GID before listen().
ExecCondition=/usr/local/bin/startup-factory-beads-controller require-enabled
# Root-owned tmpfiles performs the sole `Z` relabel. After its irreversible
# UID/GID/capability drop, the worker reads the actual security.selinux xattr
# and refuses readiness before receiving authority if it differs from the
# pinned context. The service never receives relabel authority.
ExecStart=/usr/local/bin/startup-factory-beads-controller serve
SELinuxContext=system_u:system_r:beads_controller_t:s0
Restart=on-failure
RestartSec=2s
Delegate=yes
DelegateSubgroup=controller
KillMode=control-group
TimeoutStopSec=15s
CapabilityBoundingSet=CAP_CHOWN CAP_SETGID CAP_SETUID
NoNewPrivileges=true
LockPersonality=true
MemoryDenyWriteExecute=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=false
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RemoveIPC=true
ReadWritePaths=/run/startup-factory /run/user/991/startup-factory-beads-results /run/user/993/startup-factory-beads-results /run/user/993 /var/lib/startup-factory/beads-boundary-controller/v1 /var/lib/startup-factory/beads-worker /var/lib/startup-factory/beads-handoff
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
SystemCallArchitectures=native
UnsetEnvironment=AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AZURE_CLIENT_SECRET GOOGLE_APPLICATION_CREDENTIALS DOCKER_HOST CONTAINER_HOST SSH_AUTH_SOCK
UMask=0007

[Install]
WantedBy=multi-user.target
