[Unit]
Description=Startup Factory protected Beads controller transport
Before=startup-factory-beads-controller.service

[Socket]
ListenSequentialPacket=/run/startup-factory/beads-boundary-controller-v1.sock
DirectoryMode=0750
SocketMode=0660
SocketUser=root
SocketGroup=startup-factory-beads-transport
Service=startup-factory-beads-controller.service
RemoveOnStop=true

[Install]
WantedBy=sockets.target
